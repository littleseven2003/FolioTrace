{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "eventId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "projectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "taskId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "file": {
            "$ref": "project.schema.json#/$defs/file"
          },
          "version": {
            "$ref": "project.schema.json#/$defs/version"
          }
        },
        "required": [
          "file",
          "version"
        ]
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "project.schema.json#/$defs/relation"
      }
    }
  },
  "required": [
    "schemaVersion",
    "eventId",
    "projectId",
    "taskId",
    "createdAt",
    "producer",
    "outputs",
    "relations"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foliotrace.example/schemas/change.schema.json"
}
