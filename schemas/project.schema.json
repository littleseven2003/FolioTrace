{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "projectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "relativePath": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:)(?!.*\\\\).+$"
          },
          "role": {
            "enum": [
              "reference",
              "process",
              "output",
              "excluded",
              "unclassified"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "relativePath",
          "role",
          "sha256"
        ]
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "currentVersionId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "currentVersionId"
        ]
      }
    },
    "versions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "documentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "fileId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "parentVersionId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "summary": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "referencePins": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "fileId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "relativePath": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:)(?!.*\\\\).+$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "fileId",
                "relativePath",
                "sha256"
              ]
            }
          },
          "producer": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "documentId",
          "fileId",
          "parentVersionId",
          "createdAt",
          "summary",
          "sha256",
          "referencePins",
          "producer"
        ]
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "kind": {
            "const": "companion"
          },
          "fromVersionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "toVersionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "kind",
          "fromVersionId",
          "toVersionId",
          "label"
        ]
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "taskId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "relativePath": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:)(?!.*\\\\).+$"
          },
          "status": {
            "enum": [
              "awaiting-output",
              "has-output",
              "confirmed",
              "cancelled"
            ]
          }
        },
        "required": [
          "taskId",
          "relativePath",
          "status"
        ]
      }
    },
    "importedEvents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "eventId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "importedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "eventId",
          "sha256",
          "importedAt"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "projectId",
    "name",
    "revision",
    "files",
    "documents",
    "versions",
    "relations",
    "tasks",
    "importedEvents"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
