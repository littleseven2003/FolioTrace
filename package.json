{
  "name": "foliotrace",
  "version": "0.0.0",
  "private": true,
  "description": "文脉 / FolioTrace：本地文档材料工作台",
  "license": "MIT",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "check": "node scripts/check-starter.mjs && node scripts/check-commit-message.mjs --self-test",
    "check:docs": "node scripts/check-starter.mjs",
    "check:commits": "node scripts/check-commit-message.mjs --ci",
    "hooks:install": "git config --local core.hooksPath .githooks"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "electron-vite": "6.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
